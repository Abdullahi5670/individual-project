<!doctype html>
<html>
<head><%- include('../partials/head') %><title>Sign Up</title></head>
<body>
  <%- include('../partials/nav', { user }) %>

  <main class="container py-5" style="max-width: 560px;">
    <div class="card shadow-sm p-4">
      <h2 class="h4 fw-bold mb-2">Create your account</h2>
      <p class="text-muted mb-3">Join sessions and host your own.</p>

      <% if (error) { %><div class="alert alert-danger"><%= error %></div><% } %>

      <form method="POST" action="/signup">
        <div class="mb-3">
          <label class="form-label">Name</label>
          <input class="form-control" name="name" required maxlength="40"/>
        </div>
        <div class="mb-3">
          <label class="form-label">Email</label>
          <input class="form-control" type="email" name="email" required />
        </div>
        <div class="mb-3">
          <label class="form-label">Password</label>
          <input class="form-control" type="password" name="password" required minlength="6"/>
          <div class="form-text">At least 6 characters.</div>
        </div>
        <button class="btn btn-primary w-100" type="submit">Create account</button>
      </form>

      <div class="mt-3 text-center">
        <span class="text-muted">Already have an account?</span>
        <a href="/login">Login</a>
      </div>
    </div>
  </main>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
