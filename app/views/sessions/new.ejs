<!doctype html>
<html>
<head><%- include('../partials/head') %><title>New Session</title></head>
<body>
  <%- include('../partials/nav', { user }) %>
  <main class="container py-4" style="max-width: 900px;">
    <div class="d-flex justify-content-between align-items-center mb-3">
      <h1 class="h4 fw-bold m-0">Create a Study Session</h1>
      <a class="btn btn-outline-secondary" href="/sessions">Back</a>
    </div>

    <% if (error) { %><div class="alert alert-danger"><%= error %></div><% } %>

    <div class="card shadow-sm p-3">
      <form method="POST" action="/sessions">
        <div class="row g-3">
          <div class="col-md-7">
            <label class="form-label">Title</label>
            <input class="form-control" name="title" required value="<%= form.title || '' %>">
          </div>
          <div class="col-md-5">
            <label class="form-label">Course</label>
            <input class="form-control" name="course" required placeholder="e.g., BIO101" value="<%= form.course || '' %>">
          </div>
          <div class="col-md-6">
            <label class="form-label">Tags (comma separated)</label>
            <input class="form-control" name="tags" placeholder="Exam, Homework, Lab" value="<%= (form.tags || '') %>">
          </div>
          <div class="col-md-6">
            <label class="form-label">Start time</label>
            <input class="form-control" type="datetime-local" name="starts_at" required value="<%= form.starts_at || '' %>">
          </div>
          <div class="col-md-4">
            <label class="form-label">Duration (minutes)</label>
            <input class="form-control" type="number" name="duration_min" min="15" max="360" value="<%= form.duration_min || 60 %>">
          </div>
          <div class="col-md-4">
            <label class="form-label">Capacity</label>
            <input class="form-control" type="number" name="capacity" min="2" max="200" value="<%= form.capacity || 10 %>">
          </div>
          <div class="col-md-4">
            <label class="form-label">Location</label>
            <input class="form-control" name="location" required placeholder="Library room 2B" value="<%= form.location || '' %>">
          </div>
          <div class="col-12">
            <label class="form-label">Notes</label>
            <textarea class="form-control" name="notes" rows="4" placeholder="What should people bring?"><%= form.notes || '' %></textarea>
          </div>
        </div>

        <div class="mt-3 d-flex gap-2">
          <button class="btn btn-primary" type="submit">Create session</button>
          <a class="btn btn-outline-secondary" href="/sessions">Cancel</a>
        </div>
      </form>
    </div>
  </main>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
